# ── PostgreSQL ──
POSTGRES_USER=poultry
POSTGRES_PASSWORD=change_this_to_a_strong_random_password
POSTGRES_DB=poultry_market

# ── Backend ──
# ADMIN_TOKEN is REQUIRED in production — backend will refuse to start without it
ADMIN_TOKEN=change-me-strong-token
ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000
# CORS_ORIGINS is a comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Scheduler ──
# Set to "false" to disable the scheduler (e.g. when running multiple replicas)
SCHEDULER_ENABLED=true

# ── Web ──
NEXT_PUBLIC_API_URL=/api/v1

# ── Optional: Redis (for future caching / queue) ──
# REDIS_URL=redis://redis:6379/0
